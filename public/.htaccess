# creative-vision.pl — cyber_Folks (Apache / LiteSpeed)
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Let's Encrypt: ścieżka walidacji bez przekierowań
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # HTTPS + bez www (adres kanoniczny jak we Framerze: https://creative-vision.pl)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(creative-vision\.pl)$ [NC]
  RewriteRule ^ https://creative-vision.pl%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # /strona.html → /strona
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # /strona/ → /strona (tylko gdy taka strona istnieje)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # Katalog bez własnej strony (np. /uslugi) → 404, bez pętli przekierowań
  RewriteCond %{DOCUMENT_ROOT}/$1.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1 -d
  RewriteRule ^([a-z0-9/-]+?)/?$ - [R=404,L]

  # Czyste adresy: /realizacje i /realizacje/simrun → plik .html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9/-]+)$ /$1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/(js|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
